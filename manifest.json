{
  "manifest_version": 3,
  "name": "Chrome Fiddler",
  "version": "1.4.1",
  "description": "Capture network requests and generate curl commands using the Debugger API.",
  "minimum_chrome_version": "121",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "fiddler16.png",
      "48": "fiddler48.png",
      "128": "fiddler128.png"
    }
  },
  "icons": {
    "16": "fiddler16.png",
    "48": "fiddler48.png",
    "128": "fiddler128.png"
  }
}
